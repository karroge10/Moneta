generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User table - Updated for Clerk-only authentication
model User {
  id          Int      @id @default(autoincrement())
  clerkUserId String?  @unique // Primary identifier for Clerk authentication
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Profile (optional)
  dateOfBirth   DateTime?
  country       String?
  profession    String?

  // User preferences (stored directly in User table)
  languageId       Int?
  currencyId       Int?
  dataSharingEnabled Boolean? @default(false)
  incomeTaxRate    Float?  // Percentage (e.g., 25.0 for 25%). null = disabled

  // Billing (Stripe, test mode only)
  stripeCustomerId String? @unique

  // Relations
  language    Language?    @relation(fields: [languageId], references: [id])
  currency    Currency?    @relation(fields: [currencyId], references: [id])
  notificationSettings UserNotificationSettings?
  transactions Transaction[]
  goals       Goal[]
  notifications Notification[]
  merchants   Merchant[]
  recurringTransactions RecurringTransaction[]
  pdfProcessingJobs PdfProcessingJob[]
  feedback         Feedback[]
  portfolioSnapshots PortfolioSnapshot[]
  assets           Asset[]
  learningLessonProgress LearningLessonProgress[]
  subscription     Subscription?
  payments         Payment[]
}

// Billing: our copy of the user's Stripe subscription, kept in sync by the webhook.
// One row per user; a new subscription after cancelling replaces the old one.
model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  stripeSubscriptionId String    @unique
  stripePriceId        String
  // Mirrors Stripe's status: active | trialing | past_due | unpaid | canceled |
  // incomplete | incomplete_expired | paused. Access is derived from it in lib/billing.
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Billing: one row per Stripe invoice (each subscription charge attempt lands here).
model Payment {
  id                   Int      @id @default(autoincrement())
  userId               Int
  stripeInvoiceId      String   @unique
  stripeSubscriptionId String?
  // Stripe invoice status: paid | open (payment failed, Stripe is retrying) | void | uncollectible
  status               String
  // Integer minor units exactly as Stripe sends them (400 = $4.00), with the ISO currency.
  amountDueMinor       Int
  amountPaidMinor      Int
  currency             String
  attemptCount         Int      @default(0)
  nextPaymentAttemptAt DateTime? // when Stripe will retry a failed charge (null once paid)
  hostedInvoiceUrl     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Billing: every Stripe webhook event we have processed, keyed by Stripe's event id.
// Stripe delivers at-least-once, so the same event can arrive twice; the primary key
// makes the second insert fail and we skip it.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now())
}

// Learning Center: opening a lesson marks it complete (one row per user per lesson)
model LearningLessonProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Portfolio Snapshots for historical tracking
model PortfolioSnapshot {
  id          Int      @id @default(autoincrement())
  userId      Int
  totalValue  Decimal  @db.Decimal(19, 4) // Total value of all assets combined in user's default currency
  totalCost   Decimal  @db.Decimal(19, 4) // Total cost basis in user's default currency
  totalPnl    Decimal  @db.Decimal(19, 4) // Value - Cost
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

// Feedback from Help Center (no email sending; stored in DB only)
model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  category  String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// User notification preferences (separate table - read infrequently)
model UserNotificationSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  pushNotifications  Boolean  @default(true)
  upcomingBills      Boolean  @default(true)
  upcomingIncome     Boolean  @default(true)
  investments        Boolean  @default(true)
  goals              Boolean  @default(true)
  promotionalEmail   Boolean  @default(true)
  aiInsights         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Enums for Investment Refactor
enum InvestmentType {
  buy
  sell
}

enum AssetType {
  crypto
  stock
  property
  custom
  other
}

enum PricingMode {
  live
  manual
}

// Global Asset Table
model Asset {
  id          Int          @id @default(autoincrement())
  name        String
  ticker      String?      // Optional for manual/private assets
  assetType   AssetType    // crypto | stock | property | custom | other
  coingeckoId String?
  pricingMode PricingMode  // live | manual
  icon        String?
  
  // New Fields for Private/Manual Assets
  userId      Int?         // If set, this is a private asset for this user
  manualPrice Decimal?     @db.Decimal(18, 8) // User-set price for manual tracking

  transactions Transaction[]
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([ticker])
  @@index([userId])
}

// Unified Transaction table replacing Expense and Income
model Transaction {
  id                   Int       @id @default(autoincrement())
  userId               Int
  type                 String    // 'income' | 'expense'
  amount               Decimal   @db.Decimal(19, 4) // Always positive; sign comes from type
  description          String
  source               String?   // For analytics - where transaction came from (e.g., "pdf_import", "manual")
  date                 DateTime
  categoryId           Int?
  currencyId           Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Investment Fields
  investmentAssetId Int?
  investmentType    InvestmentType?
  quantity          Decimal?        @db.Decimal(18, 8)
  pricePerUnit      Decimal?        @db.Decimal(18, 8)

  // Relations
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id])
  currency Currency     @relation(fields: [currencyId], references: [id])
  asset    Asset?       @relation(fields: [investmentAssetId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([investmentAssetId])
}

// Goal table
model Goal {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  targetDate    DateTime
  targetAmount  Decimal  @db.Decimal(19, 4)
  currentAmount Decimal  @default(0) @db.Decimal(19, 4)
  currencyId    Int?     // null = user's default currency
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@index([userId])
}

// Category table - Standard categories with icon/color mappings
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String
  color     String
  type      String?  // 'income' | 'expense' | null (null means both/all types)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  merchants     Merchant[]
  merchantsGlobal MerchantGlobal[]
}

// Notification table
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // 'Upcoming Bills', 'Goal Update', 'Upcoming Income', 'Investments', 'Goals', 'AI Insights', 'PDF Processing'
  text      String
  date      DateTime
  time      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}


// PDF Processing Job table - Tracks async PDF processing jobs
model PdfProcessingJob {
  id            String   @id @default(uuid())
  userId        Int
  status        String   // 'queued', 'processing', 'completed', 'failed'
  progress      Int      @default(0) // 0-100
  processedCount Int?    // Current number of transactions processed (e.g., 125)
  totalCount    Int?     // Total number of transactions to process (e.g., 326)
  fileContent   Bytes    // PDF file content stored in database (accessible from Render worker)
  fileName      String    // Original filename for reference
  result        Json?    // Transactions stored here when done
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// MerchantGlobal table - Global merchant-to-category mappings (shared by all users)
model MerchantGlobal {
  id          Int      @id @default(autoincrement())
  namePattern String   @unique // Normalized merchant name pattern (e.g., "starbucks", "uber")
  categoryId  Int      // The category this merchant maps to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([namePattern])
  @@index([categoryId])
}

// Merchant table - User-specific merchant-to-category mappings (overrides global)
model Merchant {
  id          Int      @id @default(autoincrement())
  userId      Int
  namePattern String   // Normalized merchant name pattern (e.g., "starbucks", "uber")
  categoryId  Int      // The category this merchant maps to
  matchCount  Int      @default(1) // How many times this mapping was confirmed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, namePattern])
  @@index([userId])
  @@index([namePattern])
}

// Currency table - Preserved from existing schema
model Currency {
  id      Int       @id @default(autoincrement())
  name    String
  symbol  String
  alias   String
  User    User[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  goals   Goal[]
  baseRates  ExchangeRate[] @relation("BaseCurrencyRates")
  quoteRates ExchangeRate[] @relation("QuoteCurrencyRates")
}

enum RecurringType {
  income
  expense
}

enum FrequencyUnit {
  day
  week
  month
  year
}

model RecurringTransaction {
  id                Int            @id @default(autoincrement())
  userId            Int
  type              RecurringType
  name              String
  amount            Decimal        @db.Decimal(19, 4)
  currencyId        Int
  categoryId        Int?
  startDate         DateTime
  nextDueDate       DateTime
  frequencyUnit     FrequencyUnit
  frequencyInterval Int            @default(1)
  endDate           DateTime?
  isActive          Boolean        @default(true)
  lastGeneratedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@index([userId])
  @@index([nextDueDate])
  @@index([type])
}

// Language table - Preserved from existing schema
model Language {
  id    Int    @id @default(autoincrement())
  name  String
  alias String
  User  User[]
}

model ExchangeRate {
  id              Int       @id @default(autoincrement())
  baseCurrencyId  Int
  quoteCurrencyId Int
  rate            Decimal   @db.Decimal(18, 8)
  rateDate        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  baseCurrency    Currency  @relation("BaseCurrencyRates", fields: [baseCurrencyId], references: [id], onDelete: Cascade)
  quoteCurrency   Currency  @relation("QuoteCurrencyRates", fields: [quoteCurrencyId], references: [id], onDelete: Cascade)

  @@unique([baseCurrencyId, quoteCurrencyId, rateDate])
  @@index([baseCurrencyId, quoteCurrencyId, rateDate])
}
