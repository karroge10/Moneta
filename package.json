{
  "name": "moneta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit --pretty",
    "seed": "tsx prisma/seed.ts",
    "seed:demo-user": "tsx scripts/seed-demo-user-full.ts",
    "seed:demographic": "tsx scripts/seed-demographic-data.ts",
    "seed:merchants": "tsx prisma/seed-merchants.ts",
    "setup": "npm install && node scripts/setup-python.js",
    "postinstall": "prisma generate",
    "verify:cron": "tsx scripts/verify-cron.ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.7",
    "@clerk/themes": "^2.4.57",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/analytics": "^2.0.1",
    "iconoir-react": "^7.11.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.12.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "detect-port": "^1.6.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
