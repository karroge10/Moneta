# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon in production). Also read by the Python service.
DATABASE_URL=postgresql://user:password@host/db

# Clerk auth (Dashboard > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public base URL of the app, used for metadata, sitemap and Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Python PDF service (Render), e.g. http://localhost:5000
PYTHON_SERVICE_URL=
# Optional: host the Python service should call back to, overrides the request host
PYTHON_SERVICE_CALLBACK_HOST=
# Shared secret between the app and the Python service; set the same value on both sides
INTERNAL_API_SECRET=
# Bearer token Vercel Cron sends to /api/cron/*
CRON_SECRET=

# Stripe, TEST MODE ONLY. The app refuses to start Stripe with a non-test key.
# Dashboard (test mode) > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Local: printed by `stripe listen`. Deployed: the signing secret of the test-mode webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Printed by `npx tsx scripts/stripe-setup.ts`
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Python service only, optional: comma-separated hosts it may POST results back to
CALLBACK_ALLOWED_HOSTS=

# Optional dev flags
# DASHBOARD_TIMING=1                 log dashboard API timings
# FAKE_DEMOGRAPHIC_COHORT=true       synthesize a peer cohort for demographic comparisons
# FAKE_DEMOGRAPHIC_COHORT_SIZE=24
# ALLOW_FAKE_DEMOGRAPHIC_COHORT_IN_PRODUCTION=true
# DEMO_SEED_CLERK_USER_ID=user_xxx   target of scripts/seed-demo-user-full.ts
# DEMO_SEED_USER_ID=42
